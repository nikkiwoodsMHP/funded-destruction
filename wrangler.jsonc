{
  "name": "holy-resonance-a508",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-07",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/editor/*"
    ]
  },
  "vars": {
    "INTAKE_ENABLED": "false",
    "RESEARCH_SEED_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "FD_DB",
      "database_name": "funded-destruction-preview",
      "database_id": "dde18b03-e448-4a00-abfd-b702fe024a6d"
    }
  ]
}
